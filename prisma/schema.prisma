datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo; los demás cubren Docker (Debian) y hosting cPanel/CloudLinux (RHEL)
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

enum Role {
  ADMIN
  EDITOR
  CLIENTE
  TEAM_311 // consultores de 311: solo trabajan reportes de los proyectos que se les asignan
  PROJECT_311 // gestiona las tareas (ve, crea, edita, asigna y acepta todas); sin reportes ni administración
}

enum ReportStatus {
  EN_PROCESO
  TERMINADO
  RECHAZADO
  APROBADO
  ENVIADO
}

enum DeletionStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(EDITOR)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  reportsCreated      Report[]             @relation("ReportCreator")
  tasksCreated        ReportTask[]
  deletionRequests    DeletionRequest[]    @relation("DeletionRequester")
  deletionReviews     DeletionRequest[]    @relation("DeletionReviewer")
  auditLogs           AuditLog[]
  clientAccess        ClientUser[]
  theme               String?              @db.VarChar(10) // "light" | "dark"; null = automático según el sistema
  passwordResets      PasswordReset[]
  registrationReviews ClientRegistration[]
  invoicesCreated     Invoice[]            @relation("InvoiceCreator")
  invoicesCollected   Invoice[]            @relation("InvoiceCollector")
  invoiceLogs         InvoiceLog[]
  ledgerEntries       LedgerEntry[]
  expensesCreated     Expense[]
  movementsCreated    Movement[]
  loansCreated        Loan[]
  loanPaymentsCreated LoanPayment[]
  documentsCreated    Document[]           @relation("DocCreator")
  documentSends       DocumentSend[]
  photoUrl            String? // Clave de la foto de perfil (TEAM 311) en el almacenamiento
  birthday            String?              @db.VarChar(5) // "MM-DD": solo día y mes
  phone               String?              @db.VarChar(20) // teléfono (solo dígitos) para abrir WhatsApp
  areas               UserArea[]
  gameScores          GameScore[]
  metaAccess          MetaAccess[]
  projectAccess       UserProject[]
  editRequests        EditRequest[]        @relation("EditRequester")
  editReviews         EditRequest[]        @relation("EditReviewer")
  workTasksCreated    Task[]               @relation("TaskCreator")
  workTaskAssignments TaskAssignee[]
  taskEvents          TaskEvent[]
  taskMessages        TaskMessage[]
  taskAttachments     TaskAttachment[]
  notifications       Notification[]
  subtasksAssigned    Subtask[]            @relation("SubtaskAssignee")
  subtasksDone        Subtask[]            @relation("SubtaskDoneBy")
  pushSubscriptions   PushSubscription[]
  notes               Note[]               @relation("NoteOwner")
  noteLabels          NoteLabel[]
  noteShares          NoteShare[]
}

model Client {
  id           String        @id @default(uuid())
  companyName  String
  folioPrefix  String        @unique // E.g., "CEM"
  mainEmails   String        @db.Text // Comma-separated emails
  logoUrl      String? // Clave del archivo del logo en el almacenamiento
  folioSeq     Int           @default(0) // Último consecutivo de folio usado (nunca se reinicia)
  createdAt    DateTime      @default(now())
  projects     Project[]
  reports      Report[]
  users        ClientUser[]
  metaAccounts MetaAccount[]

  // Datos fiscales y de contacto (solo los ven Admin y Editor)
  requiresInvoice Boolean             @default(false)
  legalName       String?             @db.VarChar(255) // Razón social para facturar
  rfc             String?             @db.VarChar(13)
  street          String?             @db.VarChar(255) // Calle y número
  colonia         String?             @db.VarChar(150)
  postalCode      String?             @db.VarChar(5)
  city            String?             @db.VarChar(120)
  state           String?             @db.VarChar(120)
  constanciaUrl   String? // Clave del PDF de la Constancia de Situación Fiscal (almacenamiento privado)
  contactName     String?             @db.VarChar(150) // Contacto principal (nombre)
  contactLastName String?             @db.VarChar(150)
  contactPhone    String?             @db.VarChar(10)
  contactEmail    String?             @db.VarChar(191)
  // Representante legal (para contratos y acuerdos; solo Admin y Editor) y consecutivo de recibos de pago
  legalRepName    String?             @db.VarChar(150)
  legalRepAddress String?             @db.VarChar(300)
  legalRepCurp    String?             @db.VarChar(18)
  legalRepIne     String?             @db.VarChar(20)
  legalRepRole    String?             @db.VarChar(120)
  receiptSeq      Int                 @default(0)
  documents       Document[]
  billingName     String?             @db.VarChar(150) // Contacto de administración y facturación (nombre)
  billingLastName String?             @db.VarChar(150)
  billingPhone    String?             @db.VarChar(10)
  billingEmail    String?             @db.VarChar(191)
  registration    ClientRegistration?
  invoices        Invoice[]
  tasks           Task[]
  notes           Note[]
}

enum RegistrationStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Registro enviado por un cliente desde el formulario público; entra al catálogo al aprobarse.
model ClientRegistration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(PENDIENTE)
  createdAt DateTime           @default(now())
  ip        String?            @db.VarChar(64)

  companyName     String  @db.VarChar(150)
  logoUrl         String?
  requiresInvoice Boolean @default(false)
  legalName       String? @db.VarChar(255)
  rfc             String? @db.VarChar(13)
  street          String? @db.VarChar(255)
  colonia         String? @db.VarChar(150)
  postalCode      String? @db.VarChar(5)
  city            String? @db.VarChar(120)
  state           String? @db.VarChar(120)
  constanciaUrl   String?
  contactName     String  @db.VarChar(150)
  contactLastName String  @default("") @db.VarChar(150)
  contactPhone    String  @db.VarChar(10)
  contactEmail    String  @db.VarChar(191)
  billingName     String  @db.VarChar(150)
  billingLastName String  @default("") @db.VarChar(150)
  billingPhone    String  @db.VarChar(10)
  billingEmail    String  @db.VarChar(191)

  reviewedById    String?
  reviewedBy      User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text
  clientId        String?   @unique
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Project {
  id                  String        @id @default(uuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectName         String
  projectEmails       String        @db.Text // Comma-separated emails (puede quedar vacío)
  responsibleName     String?       @db.VarChar(120) // Responsable del proyecto
  responsibleLastName String?       @db.VarChar(120)
  createdAt           DateTime      @default(now())
  reports             Report[]
  teamMembers         UserProject[]
  tasks               Task[]
  notes               Note[]

  @@index([clientId])
}

/// Proyectos asignados a un usuario TEAM 311 (el cliente se deduce del proyecto). Los proyectos nuevos no se asignan solos.
model UserProject {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model ClientUser {
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
}

model Report {
  id               String        @id @default(uuid())
  folio            String        @unique // E.g., "LAJ001071026" = prefijo + consecutivo + DDMMAA
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  startDate        DateTime
  endDate          DateTime
  consultants      String        @db.Text // Lista JSON de nombres de 311 CONSULTORES (MariaDB no soporta String[])
  consultantIds    String?       @db.Text // Lista JSON de ids de usuarios TEAM 311 (reportes nuevos); los anteriores solo tienen nombres
  status           ReportStatus  @default(EN_PROCESO)
  rejectionComment String?       @db.Text
  createdById      String
  createdBy        User          @relation("ReportCreator", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tasks            ReportTask[]
  auditLogs        AuditLog[]
  editRequests     EditRequest[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

/// Solicitud de un TEAM 311 para volver a editar un reporte Terminado; Admin o Editor la aprueban (vuelve a En proceso) o rechazan.
model EditRequest {
  id            String         @id @default(uuid())
  reportId      String
  report        Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("EditRequester", fields: [requestedById], references: [id])
  reason        String         @db.Text
  status        DeletionStatus @default(PENDIENTE)
  reviewedById  String?
  reviewedBy    User?          @relation("EditReviewer", fields: [reviewedById], references: [id])
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([reportId, status])
}

model ReportTask {
  executedAt      String?        @db.VarChar(16) // Fecha y hora en que se ejecutó la actividad: "AAAA-MM-DD HH:mm" (hora local, opcional)
  id              String         @id @default(uuid())
  reportId        String
  report          Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sequentialNum   Int
  title           String?        @db.VarChar(191)
  descriptionHtml String         @db.LongText // Rich Text HTML
  evidences       TaskEvidence[]
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([reportId])
}

model TaskEvidence {
  id        String     @id @default(uuid())
  taskId    String
  task      ReportTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String // Clave del archivo en el almacenamiento
  type      String // 'IMAGE', 'PDF', 'VIDEO'
  createdAt DateTime   @default(now())

  @@index([taskId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 del token enviado por correo
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AppSetting {
  key   String @id @db.VarChar(100)
  value String @db.Text
}

model DeletionRequest {
  id            String         @id @default(uuid())
  targetType    String // 'REPORT', 'TASK', 'CLIENT', 'PROJECT'
  targetId      String
  targetLabel   String?        @db.VarChar(191) // Texto legible (folio, actividad, cliente) para el historial
  reason        String?        @db.Text
  requestedById String
  requestedBy   User           @relation("DeletionRequester", fields: [requestedById], references: [id])
  status        DeletionStatus @default(PENDIENTE)
  reviewedById  String?
  reviewedBy    User?          @relation("DeletionReviewer", fields: [reviewedById], references: [id])
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // E.g., "EDITED_TASK_2", "STATUS_CHANGE_TERMINADO"
  details   String?  @db.Text // Texto JSON (el tipo Json de Prisma no es fiable en MariaDB)
  createdAt DateTime @default(now())

  @@index([reportId])
}

// ---------- Evolutivo 4: facturas y recibos ----------

enum InvoiceKind {
  FACTURA // lleva IVA (16 %) y RFC del cliente
  RECIBO // recibo simple: sin IVA
}

enum InvoiceStatus {
  ENVIADA
  PAGADA // "Vencida" no se guarda: es una Enviada cuya fecha límite ya pasó
}

enum PaymentAccount {
  CAJA_CHICA
  TRIADA
  JOHNNY_EFECTIVO
  JOHNNY_TRANS
  YISUS_EFECTIVO
  YISUS_TRANS
}

model Invoice {
  id           String          @id @default(uuid())
  kind         InvoiceKind     @default(FACTURA)
  number       String?         @db.VarChar(60) // Folio fiscal / número de factura (opcional)
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  rfc          String?         @db.VarChar(13) // RFC del cliente al momento de registrar
  description  String          @db.VarChar(500)
  subtotal     Decimal         @db.Decimal(12, 2)
  vat          Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  isSoftware   Boolean         @default(false) // Proyecto de software (la etapa 2 aplica el 30 % DEV)
  dueDate      DateTime        @db.Date // Fecha límite de pago
  status       InvoiceStatus   @default(ENVIADA)
  sentAt       DateTime        @default(now()) // Cuándo se registró el envío
  createdById  String
  createdBy    User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  paidAt       DateTime? // Marca de tiempo del cambio a Pagada
  collectedOn  DateTime?       @db.Date // Fecha real en que entró el dinero
  account      PaymentAccount?
  paidById     String?
  paidBy       User?           @relation("InvoiceCollector", fields: [paidById], references: [id])
  distribution String?         @db.Text // Etapa 2: reparto "congelado" al cobrar (JSON con porcentajes y montos)
  logs         InvoiceLog[]
  ledger       LedgerEntry[]

  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceLog {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(40) // CREATED, EDITED, PAID, REVERTED
  details   String?  @db.Text // Texto JSON
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ---------- Evolutivo 4, etapa 2: cajas, reparto y gastos ----------

enum Box {
  NOMINA
  AHORRO
  NAVIDAD
  GASTOS // caja chica de gastos
  UTILIDAD
  IMPUESTOS
  MARKETING
  GANANCIA_INTERNA
  DEV
  UTILIDAD_JOHNNY
  UTILIDAD_YISUS
}

enum CashType {
  EFECTIVO
  BANCO
}

enum LedgerKind {
  DISTRIBUCION // reparto de un cobro
  REVERSA // se deshizo el pago de una factura
  GASTO
  ANULA_GASTO
  SALDO_INICIAL
  TRASLADO
  RETIRO
  ANULA_MOVIMIENTO
  PRESTAMO // dinero que sale de una caja como préstamo
  ABONO_PRESTAMO // dinero que regresa a una caja como abono a un préstamo
  ANULA_PRESTAMO
  ANULA_ABONO
}

enum MovementKind {
  SALDO_INICIAL
  TRASLADO
  RETIRO
}

enum ExpenseKind {
  NOMINA
  OTRO
}

/// Libro de movimientos de las cajas: el saldo de una caja es la suma de sus renglones. Nada se borra ni se edita.
model LedgerEntry {
  id            String     @id @default(uuid())
  box           Box
  cashType      CashType
  amount        Decimal    @db.Decimal(12, 2) // + entra, − sale
  kind          LedgerKind
  occurredOn    DateTime   @db.Date
  invoiceId     String?
  invoice       Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expenseId     String?
  movementId    String?
  loanId        String?
  loanPaymentId String?
  note          String?    @db.VarChar(191)
  createdById   String
  createdBy     User       @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([box, cashType])
  @@index([occurredOn])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([movementId])
  @@index([loanId])
  @@index([loanPaymentId])
}

model Expense {
  id          String      @id @default(uuid())
  concept     String      @db.VarChar(200)
  kind        ExpenseKind @default(OTRO) // NOMINA descuenta de la caja Nómina; OTRO, de la caja Gastos
  cashAmount  Decimal     @db.Decimal(12, 2)
  bankAmount  Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  occurredOn  DateTime    @db.Date
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  voidedAt    DateTime?
  voidReason  String?     @db.VarChar(300)
  voidedById  String?

  @@index([occurredOn])
}

model Movement {
  id          String       @id @default(uuid())
  kind        MovementKind
  fromBox     Box?
  fromType    CashType?
  toBox       Box?
  toType      CashType?
  amount      Decimal      @db.Decimal(12, 2)
  concept     String       @db.VarChar(200)
  occurredOn  DateTime     @db.Date
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  voidedAt    DateTime?
  voidReason  String?      @db.VarChar(300)
  voidedById  String?

  @@index([occurredOn])
}

/// Préstamo: dinero que se sacó de una o varias cajas y se va devolviendo con abonos. El estado (vigente / pagado) se calcula: pagado = abonos igual al total.
model Loan {
  id              String        @id @default(uuid())
  concept         String        @db.VarChar(200)
  recipient       String        @db.VarChar(120)
  total           Decimal       @db.Decimal(12, 2)
  loanDate        DateTime      @db.Date
  alreadyDeducted Boolean       @default(false) // el dinero ya había salido de las cajas antes de registrar el préstamo (no mueve saldos)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  voidedAt        DateTime?
  voidReason      String?       @db.VarChar(300)
  voidedById      String?
  origins         LoanOrigin[]
  payments        LoanPayment[]

  @@index([loanDate])
}

/// De qué caja (y de qué parte, efectivo o banco) salió el dinero del préstamo.
model LoanOrigin {
  id       String   @id @default(uuid())
  loanId   String
  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  box      Box
  cashType CashType
  amount   Decimal  @db.Decimal(12, 2)

  @@index([loanId])
}

model LoanPayment {
  id          String    @id @default(uuid())
  loanId      String
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Restrict)
  box         Box // caja a la que regresa el dinero
  cashType    CashType
  amount      Decimal   @db.Decimal(12, 2)
  paidOn      DateTime  @db.Date
  note        String?   @db.VarChar(191)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  voidReason  String?   @db.VarChar(300)
  voidedById  String?

  @@index([loanId])
  @@index([paidOn])
}

enum DocKind {
  RECIBO
  ACUERDO
  CONTRATO
}

enum DocStatus {
  BORRADOR
  ENVIADO
}

/// Documento generado desde el módulo Documentos (recibo de pago, acuerdo de confidencialidad, contrato). Lo capturado queda en «data» (JSON).
model Document {
  id          String         @id @default(uuid())
  kind        DocKind
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  folio       String?        @db.VarChar(40) // solo recibos
  fileName    String         @db.VarChar(255) // nombre del archivo sin extensión
  data        String         @db.LongText
  status      DocStatus      @default(BORRADOR)
  createdById String
  createdBy   User           @relation("DocCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sentAt      DateTime?
  sends       DocumentSend[]

  @@index([clientId])
  @@index([kind, createdAt])
}

model DocumentSend {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentById   String
  sentBy     User     @relation(fields: [sentById], references: [id])
  toEmails   String   @db.Text
  bccEmails  String?  @db.Text
  subject    String   @db.VarChar(255)
  body       String   @db.Text
  sentAt     DateTime @default(now())

  @@index([documentId])
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  PARA_REVISAR
  TERMINADA
}

// Panel de tareas (Evolutivo 7): tareas asignadas al equipo TEAM 311 por Admin o Editor
model Task {
  id                String           @id @default(uuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  publishAt         DateTime? // Tarea programada: aparece para la persona asignada a partir de esta fecha y hora (vacío = de inmediato)
  publishNotifiedAt DateTime? // Cuándo se avisó a las personas asignadas de una tarea programada
  areaId            String? // Área de la tarea (obligatoria al crearla; las anteriores a la actualización quedan sin área)
  area              Area?            @relation(fields: [areaId], references: [id])
  title             String           @db.VarChar(191)
  descriptionHtml   String           @db.Text
  dueAt             DateTime // Fecha y hora de entrega
  status            TaskStatus       @default(PENDIENTE)
  createdById       String
  createdBy         User             @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  readyAt           DateTime? // Cuándo el TEAM 311 la marcó «Lista»
  acceptedAt        DateTime? // Cuándo pasó a TERMINADA
  surprise          Boolean          @default(false) // Sorpresa de felicitación habilitada al aceptar
  surpriseOpenedAt  DateTime?
  hiddenAt          DateTime? // «Limpiar terminadas»: se oculta del tablero pero queda en el historial
  reminderSentAt    DateTime? // Recordatorio de «vence en menos de 12 h» ya enviado
  assignees         TaskAssignee[]
  resources         TaskResource[]
  events            TaskEvent[]
  messages          TaskMessage[]
  subtasks          Subtask[]
  notes             Note[]
  attachments       TaskAttachment[]

  @@index([status])
  @@index([dueAt])
  @@index([clientId])
  @@index([projectId])
  @@index([areaId])
  @@index([publishAt])
}

// Campañas Meta: cuentas publicitarias que el portal puede gestionar (se importan del Business Manager) y quién puede verlas
model MetaAccount {
  id          String       @id @default(uuid())
  adAccountId String       @unique @db.VarChar(40) // «act_123456789»
  name        String       @db.VarChar(191)
  currency    String?      @db.VarChar(10)
  clientId    String? // Cliente del portal al que pertenece la cuenta
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  active      Boolean      @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime     @default(now())
  access      MetaAccess[]

  @@index([clientId])
}

model MetaAccess {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   MetaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

// Las Retas (juego): mejor puntaje de cada persona, por periodo: «ALL» (de siempre) y «AAAA-MM» (del mes)
model GameScore {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     String   @db.VarChar(10)
  score      Int
  achievedAt DateTime @default(now())

  @@id([userId, period])
  @@index([period, score])
}

// Áreas en que se divide el equipo (DISEÑO, CRM…): cada tarea pertenece a una; las personas pueden estar en varias
model Area {
  id        String     @id @default(uuid())
  name      String     @unique @db.VarChar(100)
  color     String     @default("#007AFF") @db.VarChar(9)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  users     UserArea[]
  tasks     Task[]
}

model UserArea {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([areaId])
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskResource {
  id       String @id @default(uuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title    String @db.VarChar(191)
  url      String @db.VarChar(1000)
  position Int    @default(0)

  @@index([taskId])
}

// Historial de la tarea: creación, movimientos, «Lista», aceptación, devoluciones, ediciones
model TaskEvent {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String   @db.VarChar(30)
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Chat de la tarea: mensajes con formato, GIF y adjuntos (no se editan ni se borran)
model TaskMessage {
  id          String           @id @default(uuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  bodyHtml    String           @db.Text
  gifUrl      String?          @db.VarChar(1000)
  createdAt   DateTime         @default(now())
  attachments TaskAttachment[]

  @@index([taskId])
}

// Archivo adjunto del chat. Se sube primero (messageId vacío) y se liga al mensaje al enviarlo
model TaskAttachment {
  id           String       @id @default(uuid())
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messageId    String?
  message      TaskMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  key          String       @db.VarChar(300)
  type         String       @db.VarChar(10) // IMAGE | VIDEO | FILE
  name         String       @db.VarChar(191)
  size         Int
  createdAt    DateTime     @default(now())

  @@index([taskId])
  @@index([messageId])
}

// Centro de avisos dentro del portal (campanita)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @db.VarChar(30)
  title     String    @db.VarChar(191)
  body      String?   @db.Text
  link      String    @db.VarChar(300)
  actorId   String?   @db.VarChar(191) // Quién generó el aviso (para mostrar su foto)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}

// Renglón de lista de verificación dentro de una tarea (Evolutivo 8)
model Subtask {
  id         String    @id @default(uuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title      String    @db.VarChar(191)
  assigneeId String?
  assignee   User?     @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt      DateTime?
  done       Boolean   @default(false)
  doneAt     DateTime?
  doneById   String?
  doneBy     User?     @relation("SubtaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  position   Int       @default(0)

  @@index([taskId])
}

// Dispositivos que activaron las notificaciones del navegador (web push) — Evolutivo 8
model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointHash String   @unique @db.VarChar(64) // SHA-256 del endpoint (el endpoint es muy largo para un índice único)
  endpoint     String   @db.Text
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  userAgent    String?  @db.VarChar(255)
  mutedKinds   String?  @db.Text // JSON con los tipos de aviso desactivados en este dispositivo
  createdAt    DateTime @default(now())

  @@index([userId])
}

// BAÚL (Evolutivo 8): notas privadas estilo Google Keep, compartibles con otras personas del personal
model Note {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kind           String          @default("TEXT") @db.VarChar(10) // TEXT | CHECKLIST
  title          String          @default("") @db.VarChar(191)
  bodyHtml       String          @default("") @db.Text
  color          String          @default("white") @db.VarChar(20)
  pinned         Boolean         @default(false)
  position       Int             @default(0)
  archivedAt     DateTime?
  trashedAt      DateTime? // En la papelera: se borra definitivamente a los 30 días
  reminderAt     DateTime?
  reminderSentAt DateTime?
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          NoteItem[]
  labels         NoteLabelLink[]
  shares         NoteShare[]

  @@index([ownerId])
  @@index([reminderAt])
}

model NoteItem {
  id       String  @id @default(uuid())
  noteId   String
  note     Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  text     String  @db.VarChar(500)
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([noteId])
}

model NoteLabel {
  id      String          @id @default(uuid())
  ownerId String
  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String          @db.VarChar(60)
  notes   NoteLabelLink[]

  @@unique([ownerId, name])
}

model NoteLabelLink {
  noteId  String
  note    Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  labelId String
  label   NoteLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([noteId, labelId])
}

model NoteShare {
  noteId   String
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canEdit  Boolean  @default(false)
  sharedAt DateTime @default(now())

  @@id([noteId, userId])
  @@index([userId])
}
